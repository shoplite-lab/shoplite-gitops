{
  "realm": "shoplite",
  "enabled": true,
  "displayName": "ShopLite",
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "rememberMe": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Normal shopper"
      },
      {
        "name": "admin",
        "description": "Can manage products"
      },
      {
        "name": "stock-writer",
        "description": "Service role: reserve stock (order-service service account)"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-shoplite",
    "composite": true,
    "composites": {
      "realm": [
        "offline_access",
        "uma_authorization",
        "customer"
      ]
    }
  },
  "groups": [
    {
      "name": "devops",
      "path": "/devops"
    },
    {
      "name": "viewers",
      "path": "/viewers"
    }
  ],
  "clients": [
    {
      "clientId": "shop-frontend",
      "name": "ShopLite Web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://shop.localhost:8000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "order-service",
      "name": "Order Service (machine)",
      "publicClient": false,
      "secret": "order-service-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "grafana",
      "name": "Grafana",
      "publicClient": false,
      "secret": "grafana-dev-secret",
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://grafana.localhost:8000/login/generic_oauth",
        "http://localhost:3000/login/generic_oauth"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@shoplite.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Customer",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-shoplite"
      ],
      "groups": []
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@shoplite.local",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-shoplite",
        "admin"
      ],
      "groups": []
    },
    {
      "username": "devops1",
      "enabled": true,
      "email": "devops1@shoplite.local",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Ops",
      "credentials": [
        {
          "type": "password",
          "value": "devops1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-shoplite"
      ],
      "groups": [
        "/devops"
      ]
    },
    {
      "username": "service-account-order-service",
      "enabled": true,
      "serviceAccountClientId": "order-service",
      "realmRoles": [
        "default-roles-shoplite",
        "stock-writer"
      ]
    }
  ],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa-dev-fixed",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": [
            "200"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "RS256"
          ],
          "privateKey": [
            ""
          ]
        }
      },
      {
        "name": "hmac-generated",
        "providerId": "hmac-generated",
        "subComponents": {},
        "config": {
          "priority": [
            "100"
          ],
          "algorithm": [
            "HS512"
          ]
        }
      },
      {
        "name": "aes-generated",
        "providerId": "aes-generated",
        "subComponents": {},
        "config": {
          "priority": [
            "100"
          ]
        }
      }
    ]
  }
}